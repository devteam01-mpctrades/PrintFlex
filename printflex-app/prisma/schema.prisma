// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// PrintFlex
//
// SQLite is the dev database, so enums and Json columns are stored as String.
// The allowed values for each String "enum" live in app/lib/types.ts and the
// JSON columns are suffixed Json and parsed in app/lib.
// ---------------------------------------------------------------------------

model Shop {
  id                 String    @id @default(cuid())
  domain             String    @unique
  plan               String    @default("FREE")
  limitBehaviour     String    @default("HARD_CAP")
  meterPeriodStart   DateTime?
  timezone           String    @default("UTC")
  pinHash            String?
  pinVersion         Int       @default(0)
  scanSecret         String?
  settingsJson       String    @default("{}")
  invoicePrefix      String    @default("INV-")
  invoiceNextNumber  Int       @default(1)
  installedAt        DateTime  @default(now())
  uninstalledAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  templates      Template[]
  savedViews     SavedView[]
  invoiceNumbers InvoiceNumber[]
  orders       OrderIndex[]
  jobs         DocumentJob[]
  documents    Document[]
  scanTokens   ScanToken[]
  packEvents   PackEvent[]
  meterEntries MeterEntry[]
  bins         BinMap[]
  bundles      BundleMap[]
  auditEntries AuditEntry[]
  scanDevices  ScanDevice[]
  sendLogs     SendLog[]
}

// A phone or scanning bench that signed in with the store PIN. The cookie
// holds "<id>.<secret>"; only sha256(secret) is stored. A device stays valid
// while it is not revoked and its pinVersion matches the shop's.
model ScanDevice {
  id         String    @id @default(cuid())
  shopId     String
  name       String
  staffLabel String?
  secretHash String    @unique
  pinVersion Int
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, revokedAt])
}

model Template {
  id                 String   @id @default(cuid())
  shopId             String
  documentType       String
  name               String
  settingsJson       String   @default("{}")
  assignmentRuleJson String   @default("{}")
  version            Int      @default(1)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  versions  TemplateVersion[]
  documents Document[]

  @@index([shopId, documentType, active])
}

model TemplateVersion {
  id                 String   @id @default(cuid())
  templateId         String
  version            Int
  settingsJson       String
  assignmentRuleJson String
  createdAt          DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model OrderIndex {
  id                String    @id @default(cuid())
  shopId            String
  shopifyOrderId    String
  orderName         String
  customerName      String?
  customerEmail     String?
  countryCode       String?
  shippingCity      String?
  itemCount         Int       @default(0)
  totalAmount       Decimal   @default(0)
  currency          String    @default("USD")
  fulfillmentStatus String    @default("UNFULFILLED")
  financialStatus   String?
  shippingMethod    String?
  tagsJson          String    @default("[]")
  documentStatus    String    @default("NEW")
  lastPrintedAt     DateTime?
  lastPackedAt      DateTime?
  shopifyCreatedAt  DateTime
  shopifyUpdatedAt  DateTime
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lineItems  OrderLineItem[]
  documents  Document[]
  scanTokens ScanToken[]
  packEvents PackEvent[]
  sendLogs   SendLog[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, orderName])
  @@index([shopId, fulfillmentStatus])
  @@index([shopId, documentStatus])
  @@index([shopId, countryCode])
  @@index([shopId, shippingMethod])
  @@index([shopId, shopifyCreatedAt])
}

model DocumentJob {
  id                String    @id @default(cuid())
  shopId            String
  name              String?
  documentTypesJson String
  orderIdsJson      String
  optionsJson       String    @default("{}")
  state             String    @default("QUEUED")
  progress          Int       @default(0)
  total             Int       @default(0)
  error             String?
  outputPath        String?
  pickListPath      String?
  outputBytes       Int?
  deadlineAt        DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  documents  Document[]
  scanTokens ScanToken[]

  @@index([shopId, state, createdAt])
}

model Document {
  id              String   @id @default(cuid())
  shopId          String
  jobId           String?
  orderId         String
  documentType    String
  templateId      String
  templateVersion Int
  invoiceNumber   String?
  filePath        String?
  byteSize        Int?
  renderedAt      DateTime @default(now())

  shop     Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  job      DocumentJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  order    OrderIndex   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([shopId, invoiceNumber])
  @@index([shopId, orderId, documentType, templateId, templateVersion])
}

// A scan token opens either one order or one batch on the scan page.
model ScanToken {
  id        String    @id @default(cuid())
  shopId    String
  orderId   String?
  jobId     String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  shop  Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order OrderIndex?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  job   DocumentJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([shopId, orderId])
  @@index([shopId, jobId])
}

model PackEvent {
  id                String   @id @default(cuid())
  shopId            String
  orderId           String
  deviceName        String
  staffLabel        String?
  outcome           String
  note              String?
  itemCount         Int?
  parcelWeightGrams Int?
  clientEventId     String?  @unique
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  shop  Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order OrderIndex @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([shopId, occurredAt])
  @@index([shopId, orderId])
}

// One row per distinct Shopify order that had a document generated in a
// calendar month (period, in the shop's timezone). The unique constraint IS
// the meter: a second insert for the same order in the same period fails and
// is ignored. orderId is the Shopify order id, not a foreign key, so the
// count survives an OrderIndex re-sync.
model MeterEntry {
  id        String   @id @default(cuid())
  shopId    String
  period    String
  orderId   String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, period, orderId])
  @@index([shopId, period])
}

model BinMap {
  id       String  @id @default(cuid())
  shopId   String
  sku      String
  bin      String
  sequence Int?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, sku])
}

model BundleMap {
  id             String  @id @default(cuid())
  shopId         String
  bundleSku      String
  componentSku   String
  componentTitle String?
  quantity       Int     @default(1)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, bundleSku, componentSku])
}

model AuditEntry {
  id          String   @id @default(cuid())
  shopId      String
  actor       String
  action      String
  subject     String?
  detailsJson String   @default("{}")
  createdAt   DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

// Line items are needed for SKU search, packing slips, pick lists and the
// pack checklist. Replaced wholesale whenever the parent order is synced.
model OrderLineItem {
  id                String  @id @default(cuid())
  orderId           String
  shopifyLineItemId String
  title             String
  variantTitle      String?
  sku               String?
  barcode           String?
  quantity          Int
  variantId         String?
  productId         String?
  imageUrl          String?
  position          Int     @default(0)

  order OrderIndex @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, shopifyLineItemId])
  @@index([sku])
}

// A merchant-defined filter combination for the orders list, stored as the
// URL query string so a view is exactly what the URL is.
model SavedView {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  query     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, name])
  @@index([shopId, position])
}

// Sequential, gapless invoice numbers. A number is bound to one order the
// moment it is allocated, inside the same transaction as the counter
// increment, so a failed render keeps its number and retries reuse it.
// Two unique constraints make both "never reused" and "once per order" a
// database guarantee.
model InvoiceNumber {
  id        String   @id @default(cuid())
  shopId    String
  orderId   String
  number    Int
  formatted String
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId])
  @@unique([shopId, number])
}

// Every automatic or manual invoice email, whether it went out or not.
model SendLog {
  id         String    @id @default(cuid())
  shopId     String
  orderId    String
  documentId String?
  templateId String?
  trigger    String
  toEmail    String
  status     String    @default("QUEUED")
  provider   String?
  messageId  String?
  error      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  shop  Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order OrderIndex @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([orderId, trigger, status])
}
