# Copy to /home/devteam01/printflex/.env on the server and fill in. Never commit the real file.
SHOPIFY_API_KEY=34363db3a11f246c64f2b24864846aea
SHOPIFY_API_SECRET=paste-from-dev-dashboard
SHOPIFY_APP_URL=https://dev.printflex.mpctrades.com
SCOPES=read_orders,write_orders,read_products
DATABASE_URL=file:/home/devteam01/printflex-data/dev.sqlite
PRINTFLEX_STORAGE_DIR=/home/devteam01/printflex-data/storage
PORT=3011
NODE_ENV=production
# Outgoing mail. Sender shown on every invoice email; replies go to the merchant's store email.
PRINTFLEX_EMAIL_FROM="PrintFlex <team@mpctrades.com>"
# SMTP for real sending (Gmail app password for team@mpctrades.com). Leave unset to keep writing .eml files to the outbox.
# PRINTFLEX_SMTP_URL=smtps://team%40mpctrades.com:app-password@smtp.gmail.com:465
