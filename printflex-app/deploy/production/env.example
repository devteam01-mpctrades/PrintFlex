# PRODUCTION environment. Lives at /home/devteam01/printflex-prod/.env on the server. Never commit the real file.
# The Shopify key and secret are the listed PrintFlex app's (client_id 34363db3...), never the dev app's.
SHOPIFY_API_KEY=34363db3a11f246c64f2b24864846aea
SHOPIFY_API_SECRET=paste-from-dev-dashboard
SHOPIFY_APP_URL=https://app.printflex.mpctrades.com
SCOPES=read_orders,write_orders,read_products
# PostgreSQL database printflex_prod (role printflex_prod). The password is generated on the server.
DATABASE_URL=postgresql://printflex_prod:PASSWORD@127.0.0.1:5432/printflex_prod
PRINTFLEX_STORAGE_DIR=/home/devteam01/printflex-prod-data/storage
PORT=3012
NODE_ENV=production
# Outgoing mail. Sender shown on every invoice email; replies go to the merchant's store email.
PRINTFLEX_EMAIL_FROM="PrintFlex <team@mpctrades.com>"
# Gmail API credentials for the team mailbox (see deploy/dev-server/README.md). Leave unset to write .eml files instead.
# PRINTFLEX_GMAIL_CLIENT_ID=
# PRINTFLEX_GMAIL_CLIENT_SECRET=
# PRINTFLEX_GMAIL_REFRESH_TOKEN=
# Offsite backups: the rclone remote and bucket path backup.sh copies each dump to. Leave unset to keep local copies only.
# PRINTFLEX_BACKUP_REMOTE=b2:printflex-backups/prod
